"inapp_message_policy" = "- खरीद की पुष्टि पर iTunes अकाउंट से भुगतान लिया जाएगा।\n- यदि वर्तमान अवधि के समाप्त होने से कम से कम 24 घंटे पहले ऑटो-रिन्यू बंद नहीं किया गया है, तो सदस्यता अपने आप नवीनीकरण होगी।\n- खरीद की पुष्टि के बाद वर्तमान अवधि के समाप्त होने से 24 घंटे पहले नवीनीकरण के लिए खाता चार्ज किया जाएगा।\n- उपयोगकर्ता अपने खाते की सेटिंग्स में जाकर ऑटो-रिन्यू बंद कर सकता है।\n- यदि मुफ्त ट्रायल अवधि उपलब्ध है, तो उपयोग न किए गए भाग को सब्सक्रिप्शन खरीदने पर खो दिया जाएगा।";
"inapp_message_trial_policy" = "- %d-दिन का मुफ्त परीक्षण, फिर %@/%@। सदस्यता अपने आप नवीनीकृत होती रहती है जब तक कि इसे परीक्षण समाप्त होने से कम से कम 24 घंटे पहले रद्द न किया जाए। अपनी Apple ID सेटिंग्स में प्रबंधित या रद्द करें।\n";
"message" = "खरीदारी की पुष्टि पर भुगतान iTunes खाते से लिया जाएगा। सब्सक्रिप्शन स्वतः नवीनीकृत हो जाएगा जब तक कि वर्तमान अवधि के समाप्त होने से कम से कम 24 घंटे पहले ऑटो-नवीनीकरण बंद न किया जाए। पुष्टि के बाद वर्तमान अवधि के समाप्त होने से 24 घंटे पहले सब्सक्रिप्शन के नवीनीकरण के लिए खाते से शुल्क लिया जाएगा। उपयोगकर्ता द्वारा सब्सक्रिप्शन प्रबंधित किया जा सकता है और खरीदारी के बाद उपयोगकर्ता के खाते की सेटिंग्स में जाकर ऑटो-नवीनीकरण बंद किया जा सकता है। यदि निःशुल्क परीक्षण अवधि की पेशकश की जाती है, तो जब उपयोगकर्ता उस प्रकाशन का सब्सक्रिप्शन खरीदता है, तो शेष निःशुल्क परीक्षण अवधि की कोई भी अप्रयुक्त अवधि समाप्त हो जाएगी।";
