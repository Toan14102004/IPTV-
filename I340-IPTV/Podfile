# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'
source 'https://github.com/CocoaPods/Specs.git'
target 'I340-IPTV' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!
  
  # Pods for I340-IPTV
  
  pod 'MaterialComponents/Buttons', '= 113.0.0'
  pod 'MaterialComponents/Cards', '= 113.0.0'
  pod 'RxSwift', '= 6.9.0'
  pod 'RxCocoa', '= 6.9.0'
  pod 'RxRelay', '= 6.9.0'
  
  pod 'Google-Mobile-Ads-SDK'
  pod 'GoogleMobileAdsMediationFacebook', '~> 6.20.1.0'
  pod 'GoogleMobileAdsMediationPangle'
  pod 'GoogleMobileAdsMediationMintegral'
  pod 'GoogleMobileAdsMediationAppLovin'
  pod 'FBAudienceNetwork', '= 6.20.1'
  
  pod 'Firebase/Core', '~> 12.18.0'
  pod 'Firebase/Analytics'
  pod 'Firebase/Messaging'
  pod 'Firebase/Crashlytics'
  pod 'Firebase/RemoteConfig'
  
  pod 'Siren', '= 6.1.3'
  pod 'SwiftUIIntrospect', '= 26.0.0'
  pod 'Loaf', '= 0.7.0'
  
  pod 'Kingfisher', '= 7.11.0'

  # Watch-together rooms (Socket.IO v4 server)
  pod 'Socket.IO-Client-Swift', '= 16.1.1'
  

  #Alamofire
  pod 'Alamofire', '= 5.9.1'
  
  
  # Adjust
  pod 'Adjust', '~> 5.8.0'
  
  pod 'FBSDKCoreKit'
  
  # TikTok SDK
  pod 'TikTokBusinessSDK'
end

post_install do |pi|
  # These source-based pods do not ship a released privacy manifest yet.
  # Add a target-owned manifest so Xcode places it inside each built framework.
  privacy_manifests = {
    'Siren' => 'PrivacyManifests/Siren/PrivacyInfo.xcprivacy'
  }

  privacy_manifests.each do |target_name, relative_path|
    target = pi.pods_project.targets.find { |candidate| candidate.name == target_name }
    next unless target

    manifest_path = File.expand_path(relative_path, __dir__)
    file_reference = pi.pods_project.main_group.new_file(manifest_path)
    target.resources_build_phase.add_file_reference(file_reference, true)
  end

  pi.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
