//
//  AppRelease.xcconfig
//  I340_IPTV
//
//  Giá trị THẬT của bản Release. `__SET_ME__` = còn thiếu, phải xin PM.
//  Build phase "Release Preflight" chặn build Release khi còn __SET_ME__ hoặc giá trị test.
//  ID test của bản Debug nằm ở AppDebug.xcconfig — không copy ngược sang đây.
//

//Define
//PROTOCOL_HTTP if url start with https:/
//PROTOCOL_HTTPS if url start with https:/
PROTOCOL_HTTP = http:/
PROTOCOL_HTTPS = https:/

//Server
SearchAdsTrackingDomain    = $(PROTOCOL_HTTPS)/appletracking.fuentechsoft.com/

//AppInfo
ApplicationID               = __SET_ME__
EmailDeveloper              = __SET_ME__
EnableShowReviewDialog      = YES
AppGroupID                  = __SET_ME__
PrivacyPolicyUrl            = __SET_ME__
TermOfUseUrl                = __SET_ME__
RefundUrl                   = __SET_ME__

//META
FacebookAppID               = __SET_ME__
FacebookClientToken         = __SET_ME__
FBAPPID                     = __SET_ME__

// TikTok
TikTokAppID                = __SET_ME__
TikTokAccessToken          = __SET_ME__

//Advertisement - PRODUCTION ad unit IDs
EnableShowAds               = YES
ADSAppID                    = __SET_ME__

ADSInterstitialAdsID           = __SET_ME__

ADSNativeAdsMediaViewID        = __SET_ME__
ADSNativeAdsNoMediaViewID      = __SET_ME__

ADSNativeLanguageAdsID         = __SET_ME__
ADSNativeLanguageAds2FID       = __SET_ME__
ADSNativeLanguageAdsMFID       = __SET_ME__

ADSNativeIntroFirstID            = __SET_ME__
ADSNativeIntroFirst2FID          = __SET_ME__
ADSNativeIntroFirstMFID          = __SET_ME__

ADSNativeIntroThirdID            = __SET_ME__
ADSNativeIntroThird2FID          = __SET_ME__
ADSNativeIntroThirdMFID          = __SET_ME__

ADSNativeFullScreenID    = __SET_ME__
ADSNativeFullScreen2FID  = __SET_ME__
ADSNativeFullScreenMFID  = __SET_ME__

ADSAppOpenAdsID                = __SET_ME__

ADSInterstitialOpenAppID       = __SET_ME__
ADSInterstitialOpenApp2FID     = __SET_ME__
ADSInterstitialOpenAppMFID     = __SET_ME__

ADSInterstitialBackgroundID    = __SET_ME__

ADSBannerID                    = __SET_ME__

ADSRewardedVideoAdsID          = __SET_ME__
ADSRewardedVideoAds2FID        = __SET_ME__
ADSRewardedVideoAdsMFID        = __SET_ME__

//InAppPurcharse - PRODUCTION product IDs
EnableShowInApp             = YES
EnableShowInAppWhenOpenApp  = YES
IAPSubcriptionSecret        = __SET_ME__
OneTime                     = __SET_ME__
IAPWeekly                   = __SET_ME__
IAPYearly                   = __SET_ME__
IAPMonthly                  = __SET_ME__
IAPYearlySaleOff            = __SET_ME__
IAPMiniPackage              = __SET_ME__
InfoPremium0                = Remove all ads
InfoPremium1                = Unlimited playlists and streams
InfoPremium2                = Unlimited watch time, no 10-minute limit
IAPMessage                  = Payment will be charged to iTunes Account at confirmation of purchase. Subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of current period. Account will be charged for renewal within 24-hours prior to the end of current period after confirmation of purchase. Subscription may be managed by the user and auto-renewal may be turned off by going to the user Account Settings after purchase. Any unused portion of free trial period, if offered, will be forfeited when the user purchases a subscription to that publication, where applicable.

//LocalNotification
EnableLocalNotification     = YES
TimeTriggerNotification     = 86400
ContentTriggerDescription   = Upgrade your account to Premium so you can use all functions today.
