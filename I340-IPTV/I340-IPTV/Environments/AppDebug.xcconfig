//  MARK: -- CHÚ Ý
//  AppName, BundleVersion BundleVersionString, ADSAppID(Admob app id)
//  Những thông tin này chỉnh sửa ở đây, không cần chỉnh sửa trong file Info.plist
//  Đổi thông tin url như privacy, term of use, nếu chưa hiểu thì liên hệ dev

//Define
//PROTOCOL_HTTP if url start with https:/
//PROTOCOL_HTTPS if url start with https:/
PROTOCOL_HTTP = http:/
PROTOCOL_HTTPS = https:/

//Server
SearchAdsTrackingDomain    = $(PROTOCOL_HTTPS)/appletracking.fuentechsoft.com/

//AppInfo
ApplicationID               = id0000000000
EmailDeveloper              = your-email@example.com
EnableShowReviewDialog      = YES
AppGroupID                  = group.com.I340_IPTV
PrivacyPolicyUrl            = $(PROTOCOL_HTTPS)/fuentechsoft.com/about/privacy/
TermOfUseUrl                = $(PROTOCOL_HTTPS)/fuentechsoft.com/terms/
RefundUrl                   = $(PROTOCOL_HTTPS)/fuentechsoft.com/refund/

