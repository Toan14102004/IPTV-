"guide_title" = "How To Use???";
"guide_step_format" = "Step %d";
"guide_step_1_title" = "Empty Playlist Screen";
"guide_step_1_body" = "• Open the app → the Playlist tab shows an empty state: “No playlists yet” — prompting the user to tap the Add (+) button on the bottom navigation bar to create the first playlist.\n• Alternatively, the user can select the Xtream tab on the bottom navigation bar to switch to the Xtream screen.";
"guide_step_2_title" = "Open the Menu to Select an Import Method";
"guide_step_2_body" = "From the Playlist screen, tap the menu icon (⋯) — the Menu appears with 4 options:\n• Import Playlist URL\n• Import from Xtream Code API\n• Import from Device\n• Play Single Stream";
"guide_step_3_title" = "Enter Information Based on the Selected Method";
"guide_step_3_intro" = "Depending on the selection made in Step 2, the “Add Channel to Playlist” screen (or “Add Stream” screen) displays the corresponding form:\n• Import Playlist URL → M3U tab: enter Name + Playlist URL (M3U/M3U8)";
"guide_step_3_xtream" = "• Import from Xtream Code API → Xtream tab: enter Name + Server URL + Username + Password";
"guide_step_3_file" = "• Import from Device → File tab: enter Name → tap “Please select an M3U/M3U8/M3U8 file” to choose a file from the device";
"guide_step_3_stream" = "• Play Single Stream → Add Stream screen: enter Stream Name + Stream URL (supports http, ftp, mms, rtsp, rtp, udp, etc.)";

